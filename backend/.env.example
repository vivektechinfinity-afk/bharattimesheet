# ---- Server ----
NODE_ENV=development
PORT=5000

# Comma-separated list of allowed frontend origins (leave unset to allow all in dev)
CORS_ORIGIN=http://localhost:3000

# ---- Database ----
# Railway injects DATABASE_URL automatically when you add the Postgres plugin.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/timesheet_db

# Used only when DATABASE_URL is not set
DB_HOST=localhost
DB_PORT=5432
DB_NAME=timesheet_db
DB_USER=postgres
DB_PASSWORD=postgres

# ---- Auth ----
# MUST be changed in production. Generate with: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRY=7d

# ---- Uploads ----
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# ---- Seeding ----
# Password given to every demo user by `npm run init-db`
SEED_PASSWORD=password123
